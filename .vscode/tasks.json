{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "local: <daemon> start",
      "type": "shell",
      "command": "cargo",
      "args": ["run", "--bin", "opn", "--", "worker", "start", "-H", "127.0.0.1", "-p", "8765"],
      "isBackground": true,
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "local: <daemon> status",
      "type": "shell",
      "command": "cargo",
      "args": ["run", "--bin", "opn", "--", "worker", "status"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "local: <daemon> stop",
      "type": "shell",
      "command": "cargo",
      "args": ["run", "--bin", "opn", "--", "worker", "stop"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "local: <cli> dev",
      "type": "shell",
      "command": "cargo",
      "args": ["run", "--bin", "opn"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
