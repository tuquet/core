      "type": "shell",
      "command": "cargo",
      "args": ["install", "--path", "crates/cli", "--bin", "opn", "--debug", "--force", "--root", "${userHome}/.operon"],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
